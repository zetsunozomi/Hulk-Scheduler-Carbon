# P0/P1 generated outputs and local environment
# Generated outputs: track text only. Checkpoints and binary artifacts stay ignored.
# Reopen directories so text files at every depth can be discovered.
/results/**
/out/**
!/results/**/
!/out/**/
!/results/**/*.log
!/results/**/*.out
!/results/**/*.err
!/results/**/*.txt
!/results/**/*.text
!/results/**/*.json
!/results/**/*.jsonl
!/results/**/*.ndjson
!/results/**/*.csv
!/results/**/*.tsv
!/results/**/*.md
!/results/**/*.yaml
!/results/**/*.yml
!/out/**/*.log
!/out/**/*.out
!/out/**/*.err
!/out/**/*.txt
!/out/**/*.text
!/out/**/*.json
!/out/**/*.jsonl
!/out/**/*.ndjson
!/out/**/*.csv
!/out/**/*.tsv
!/out/**/*.md
!/out/**/*.yaml
!/out/**/*.yml

# Current 64-iteration run: keep training text only at iteration 10, midpoint 32, and final 64.
# A future run with a different length needs explicit midpoint/final entries here.
/results/**/iteration-*/
/results/**/.iteration-*/
!/results/**/iteration-000010/
!/results/**/iteration-000032/
!/results/**/iteration-000064/

# Exclude checkpoint names, including text metadata and whole checkpoint directories.
/results/**/*[Cc][Hh][Ee][Cc][Kk][Pp][Oo][Ii][Nn][Tt]*
/results/**/*[Cc][Kk][Pp][Tt]*
/out/**/*[Cc][Hh][Ee][Cc][Kk][Pp][Oo][Ii][Nn][Tt]*
/out/**/*[Cc][Kk][Pp][Tt]*
/build/
/dist/
*.egg-info/
/.venv/
/slurm-*.out
/configs/*.local.json

/configs/*.local.env

# Dependency manifests must travel with cluster handoffs despite the legacy *.txt rule.
!/requirements-p2.txt
!/requirements-p3.txt
!/requirements-plots.txt

# Local-only validation plotting script and its generated figures/data.
/scripts/local_plot_validation_tradeoff.py
/local-plots/validation-tradeoff/
